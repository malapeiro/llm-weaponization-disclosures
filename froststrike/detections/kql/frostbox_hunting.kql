// Microsoft Sentinel hunting queries — assumes the FROSTBOX audit JSONL is
// ingested into a custom table named FrostboxAudit_CL with inferred suffixes
// (_s = string, _d = double). Adapt names to your pipeline.
//
// NOTE: run each query individually. The `let store_tz` declaration is
// repeated in each query that needs it; pasting the whole file into a single
// execution window fails on let-redefinition. One query per execution, as
// normal for hunting queries.
//
// Timezone: queries #2, #4 and #5 compare event time against the store's
// LOCAL maintenance (08:00-17:59) and defrost (02:00-04:59) windows, using
// datetime_utc_to_local(TimeGenerated, store_tz). Set store_tz per store/site
// (default "Europe/Lisbon"); a UTC hour comparison drifts by the offset and
// mis-flags window edges.

// 1. Out-of-band setpoint writes (any time)
FrostboxAudit_CL
| where Event_s == "CFG_SETPOINT"
| extend NewSetpoint = todouble(New_d), CaseId = Case_s
| where (CaseId startswith "FZ-" and (NewSetpoint > -15 or NewSetpoint < -30))
     or (CaseId startswith "CH-" and (NewSetpoint > 6 or NewSetpoint < 0))
| project TimeGenerated, SimTime_s, CaseId, NewSetpoint, Actor_s
| order by TimeGenerated asc

// 2. Configuration changes outside the maintenance window (08:00-17:59 local)
let store_tz = "Europe/Lisbon";
FrostboxAudit_CL
| where Event_s in ("CFG_SETPOINT", "CMD_DEFROST", "CFG_ALARM")
| extend Hour = hourofday(datetime_utc_to_local(TimeGenerated, store_tz))
| where Hour < 8 or Hour >= 18
| project TimeGenerated, Event_s, Case_s, Actor_s, Hour

// 3. Alarm suppression events
FrostboxAudit_CL
| where Event_s == "CFG_ALARM"
| where Enabled_b == false or todouble(High_d) > 40
| project TimeGenerated, Case_s, Actor_s

// 4. Correlated sabotage pattern: >= 3 cases touched within 5 minutes by one actor
//    v1.2 SCOPING (operator fp_probe finding): counting cases per actor alone
//    false-positives on legitimate seasonal multi-case maintenance (a technician
//    tuning several cases in one morning would raise a CRIT, and repeated CRITs
//    on normal work get rules disabled in a SOC). Only events that already carry
//    a secondary anomaly signal feed the correlation: out-of-band setpoint,
//    off-schedule defrost (outside 02:00-04:59 local), alarm suppression, or any
//    config/command event outside the maintenance window (08:00-17:59 local).
//    In-window, in-band, alarm-preserving maintenance stays invisible.
let store_tz = "Europe/Lisbon";
FrostboxAudit_CL
| where Event_s in ("CFG_SETPOINT", "CMD_DEFROST", "CFG_ALARM")
| extend Hour = hourofday(datetime_utc_to_local(TimeGenerated, store_tz)),
         NewSetpoint = todouble(New_d)
| where (Event_s == "CFG_SETPOINT"
         and ((Case_s startswith "FZ-" and (NewSetpoint > -15 or NewSetpoint < -30))
              or (Case_s startswith "CH-" and (NewSetpoint > 6 or NewSetpoint < 0))))
     or (Event_s == "CMD_DEFROST" and (Hour < 2 or Hour >= 5))
     or (Event_s == "CFG_ALARM" and (Enabled_b == false or todouble(High_d) > 40))
     or (Hour < 8 or Hour >= 18)
| summarize Cases = dcount(Case_s), Events = count()
    by Actor_s, bin(TimeGenerated, 5m)
| where Cases >= 3

// 5. Patient-actor horizon (v1.3, engine dual-horizon parity): the burst query
//    above is evaded by spacing pairs of cases >5 min apart. Same secondary-
//    signal filter, shift-scale window: >=3 distinct anomalous cases per actor
//    within 1 h catches the slow whole-fleet pattern at the 3rd case.
let store_tz = "Europe/Lisbon";
FrostboxAudit_CL
| where Event_s in ("CFG_SETPOINT", "CMD_DEFROST", "CFG_ALARM")
| extend Hour = hourofday(datetime_utc_to_local(TimeGenerated, store_tz)),
         NewSetpoint = todouble(New_d)
| where (Event_s == "CFG_SETPOINT"
         and ((Case_s startswith "FZ-" and (NewSetpoint > -15 or NewSetpoint < -30))
              or (Case_s startswith "CH-" and (NewSetpoint > 6 or NewSetpoint < 0))))
     or (Event_s == "CMD_DEFROST" and (Hour < 2 or Hour >= 5))
     or (Event_s == "CFG_ALARM" and (Enabled_b == false or todouble(High_d) > 40))
     or (Hour < 8 or Hour >= 18)
| summarize Cases = dcount(Case_s), Events = count()
    by Actor_s, bin(TimeGenerated, 1h)
| where Cases >= 3
